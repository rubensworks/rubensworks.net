---
// The bibliography, grouped by year: an <h2> per year over an <ol class="bibliography"> of
// <li>, each with a "More" link to the publication's own page. The word on screen stays
// "More" — it is what the page has always read — followed by the publication's title in a
// span that is visible only to a screen reader, so a list of links is not 97 identical
// entries reading "More". The tags and labels come from
// `site.scholar`.
//
// Note the two hrefs differ by a trailing slash — the title links to `/publications/KEY`
// while the details link points at `/publications/KEY/`.
import BibEntry from './BibEntry.astro'
import type { Entry, Knows } from '../lib/bibliography'
import { groupByYear } from '../lib/bibliography'
import { site } from '../site.config'

interface Props {
  entries: Entry[]
  knows: Knows
  /** `--group_by year --group_order descending`; ungrouped otherwise. */
  groupByYear?: boolean
}
const { entries, knows, groupByYear: grouped = false } = Astro.props as Props

const groups: [number | null, Entry[]][] = grouped
  ? groupByYear(entries)
  : [[null, entries]]
---
{groups.map(([year, groupEntries]) => (
  <Fragment>
    {year !== null && <h2 class="bibliography">{year}</h2>}
    <ol class="bibliography">{groupEntries.map((entry) => (
      <li><BibEntry entry={entry} knows={knows} /><a class={site.scholar.detailsLinkClass} href={`/${site.scholar.detailsDir}/${entry.key}/`}>{site.scholar.detailsLink}<span class="visually-hidden"> about {entry.title}</span></a></li>
    ))}</ol>
  </Fragment>
))}
