---
// Port of old-projects.html
import Page from '../layouts/Page.astro'
import { getCollection } from 'astro:content'

// Finished projects, in the order this page has always shown them: `start` compared as a
// *string* rather than a date, so "August 2011" sorts before "October 2008", then reversed.
// Ties (two projects starting "2009") keep their alphabetical file order under a stable
// sort, which reversing then flips.
const projects = (await getCollection('projects'))
  .filter((p) => p.data.end !== undefined)
  .sort((a, b) => String(a.data.start ?? '').localeCompare(String(b.data.start ?? ''), 'en'))
  .reverse()
---
<Page
  title="Old Projects"
  url="/old-projects/"
  description="Projects Ruben Taelman used to work on, from Android apps and game modifications to Flash gaming sites, kept here as a record of what they taught him."
>
<p>
This page lists some of the projects I used to work on in the past.
Their main purpose was learning experience.
</p>

<ul class="projects">
{projects.map((project) => (
    <li><a href={`/projects/${project.id}/`}>{project.data.title}</a></li>
))}
</ul>
</Page>
