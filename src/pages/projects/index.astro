---
// Port of projects.html
import Page from '../../layouts/Page.astro'
import { getCollection } from 'astro:content'

// `{% assign projects = site.projects | sort: 'weight' %}` then `{% unless project.end %}`:
// current projects only, in weight order (1, 2, 3, 4, 5, 9).
const projects = (await getCollection('projects'))
  .filter((p) => p.data.end === undefined)
  .sort((a, b) => (a.data.weight ?? 0) - (b.data.weight ?? 0))
---
<Page title="Projects" url="/projects/">
<p>
This page contains a list of the most notable things I am currently working on.
</p>

<ul class="projects">
{projects.map((project) => (
    <li class="listed">
		<a href={`/projects/${project.id}/`}>{project.data.title}</a>
		<p class="indent"><em>{project.data.description}</em></p>
	</li>
))}
</ul>

<hr/>
<small><em>Looking for my <a href="/old-projects/">older projects</a>?</em></small>
</Page>
