---
// One page per publication, at /publications/<citation-key>/.
//
// A colon or whitespace in a key would have to be rewritten to `_` to make a usable path.
// No key in references.bib contains either, so keys pass through unchanged — asserted below
// rather than assumed.
import PublicationDetail from '../../layouts/PublicationDetail.astro'
import { loadBibliography, loadKnows } from '../../lib/bibliography'
import { loadBibtexBlocks } from '../../lib/bibtex-serialise'
import { site } from '../../site.config'

export async function getStaticPaths() {
  const entries = loadBibliography()
  const knows = loadKnows()
  const blocks = loadBibtexBlocks(site.scholar.bibtexSkipFields)

  if (entries.length !== blocks.size) {
    throw new Error(
      `bibliography/serialiser disagree: ${entries.length} entries vs ${blocks.size} BibTeX blocks`,
    )
  }

  return entries.map((entry) => {
    const key = entry.key.replace(/[:\s]+/g, '_')
    if (key !== entry.key) {
      throw new Error(`Entry key "${entry.key}" would be rewritten to "${key}" — URLs would change`)
    }
    const bibtex = blocks.get(entry.key)
    if (!bibtex) throw new Error(`No serialised BibTeX for entry "${entry.key}"`)
    return { params: { key }, props: { entry, knows, bibtex } }
  })
}

const { entry, knows, bibtex } = Astro.props
---
<PublicationDetail entry={entry} knows={knows} bibtex={bibtex} url={`/publications/${entry.key}/`} />
