---
// The posts, at /blog/:year/:month/:day/:slug/
import { render } from 'astro:content'
import Post from '../../layouts/Post.astro'
import { loadPosts } from '../../lib/posts'

export async function getStaticPaths() {
  const posts = await loadPosts()
  return posts.map((post) => ({
    // The leading slash is stripped: the route is /blog/[...slug].
    params: { slug: post.url.replace(/^\/blog\//, '').replace(/\/$/, '') },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post.entry)
const d = post.entry.data

// The class the RunKit loader looks for. Reading it from the body keeps the decision with
// the post: adding a notebook to another one needs no change here.
const runkit = (post.entry.body ?? '').includes('demo-nodejs')
---
<Post
  url={post.url}
  title={d.title}
  subtitle={d.subtitle}
  date={post.date}
  author={d.author}
  featureImg={d.feature_img}
  excerpt={post.excerpt}
  comments={d.comments ?? false}
  runkit={runkit}
>
  <Content />
</Post>
