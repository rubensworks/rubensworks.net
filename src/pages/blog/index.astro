---
// Port of blog.md
import Page from '../../layouts/Page.astro'
import PostListing from '../../components/PostListing.astro'
import { loadPosts } from '../../lib/posts'

const posts = await loadPosts()
---
<Page
  title="Blog"
  url="/blog/"
  description="Posts by Ruben Taelman on Linked Data, decentralization, query execution over the Web, JavaScript, and open source development."
>
<ul class="posts">
  {posts.map((post) => (
    <li>
      <PostListing
        url={post.url}
        title={post.entry.data.title}
        subtitle={post.entry.data.subtitle}
        date={post.date}
        excerpt={post.excerpt}
      />
    </li>
  ))}
</ul>
</Page>
