---
// cv.md, read from the repository root.
//
// Liquid first, Markdown second: the 55 cv-listing entries, the presentations include, and
// the 11 {% bibliography %} / {% bibliography_count %} tags are expanded, then the result
// goes through the same Markdown pipeline as every other page. See src/lib/liquid-pages.ts.
import Page from '../layouts/Page.astro'
import { createMarkdownProcessor } from '@astrojs/markdown-remark'
import { loadLiquidPage } from '../lib/liquid-pages'
import { markdownOptions, restoreRdfaDatatype } from '../lib/markdown/pipeline'

const processor = await createMarkdownProcessor(markdownOptions as any)
// The `markdownify` filter, used by cv-listing for its subject/location/description.
const renderFragment = async (md: string) => (await processor.render(md)).code
const expanded = await loadLiquidPage('cv.md', renderFragment)
const html = restoreRdfaDatatype((await processor.render(expanded)).code)
---
<Page
  title="Curriculum Vitae"
  url="/cv/"
  description="Curriculum vitae of Ruben Taelman: positions, education, publications, student supervision, teaching, awards, and service to the Semantic Web community."
>
<Fragment set:html={html} />
</Page>
