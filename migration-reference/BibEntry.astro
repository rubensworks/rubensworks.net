---
// Port of _layouts/bib.html
import type { Entry } from '../lib/bibliography'
interface Props { entry: Entry; knows: Record<string, { url: string; foaf: string }> }
const { entry, knows } = Astro.props as Props
---
<div class="publication listed" itemscope itemtype="http://schema.org/ScholarlyArticle" typeof="schema:ScholarlyArticle schema:CreativeWork" about={`/publications/${entry.key}/#publication`}>
  <span class="type">{entry._type}</span>
  <a href={`/publications/${entry.key}`} class="title" about={`/publications/${entry.key}/#publication`}><span itemprop="name" property="schema:name">{entry.title}</span></a><br />
  <ol class="authors">{entry.authors.map((author, authorId) => {
    const k = knows[author.display]
    return <li>{k
      ? <Fragment><a class="author" itemprop="author" rel="foaf:maker schema:creator schema:author" href={k.url} resource={k.foaf} target="_blank">{author.display}</a><span property="bibframe:contribution" style="display:none" typeof="bibframe:Contribution"><a property="bibframe:agent" style="display:none" href={k.foaf}></a><span property="vivo:rank" style="display:none">{authorId}</span></span></Fragment>
      : <span itemprop="author">{author.display}</span>}</li>
  })}</ol>
  {entry.booktitle && <span class="in">In {entry.booktitle} ({entry.year})</span>}
  {entry.journal && <span class="in">In {entry.journal} ({entry.year})</span>}
  <span property="schema:abstract" style="display:none">{entry.abstract}</span>
  <span property="schema:datePublished" style="display:none" datatype="xsd:gYear">{entry.year}</span>
  <a rel="schema:contributor" style="display:none" href="https://data.knows.idlab.ugent.be/person/office/#"></a>
  <a rel="schema:about" style="display:none" href="http://dbpedia.org/resource/Semantic_Web"></a>
</div>
