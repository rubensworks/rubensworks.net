{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "layout": {
      "type": "string"
    },
    "categories": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "comments": {
      "type": "boolean"
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "date": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "feature_img": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "layout",
    "categories",
    "tags",
    "title",
    "date"
  ]
}